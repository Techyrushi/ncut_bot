[Unit]
Description=NCUT Application Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ncut-app
Group=ncut-app
WorkingDirectory=/var/www/ncut-app
ExecStart=/usr/bin/node /var/www/ncut-app/backend/dist/src/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/ncut-app/uploads
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
