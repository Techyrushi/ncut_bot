{
  "name": "@whatsapp-automation/backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests --ext .ts",
    "test": "jest --runInBand",
    "seed:catalogue": "tsx src/scripts/seed-catalogue.ts",
    "seed:enquiry-template": "tsx src/scripts/seed-enquiry-template.ts"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "exceljs": "^4.4.0",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.24.10",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.5",
    "@types/supertest": "6.0.2",
    "@types/web-push": "^3.6.4",
    "eslint": "10.15.0",
    "jest": "29.7.0",
    "mongodb-memory-server": "10.1.4",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "tsx": "4.23.15",
    "typescript": "5.7.2",
    "typescript-eslint": "8.73.0"
  }
